<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_player_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <ImageButton
        android:id="@+id/btnPlayerToggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Play or pause audio"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/primary" />

    <SeekBar
        android:id="@+id/sbPlayerProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:max="1000"
        android:progressBackgroundTint="@color/card_stroke"
        android:progressTint="@color/primary"
        android:thumbTint="@color/primary" />

    <TextView
        android:id="@+id/tvPlayerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="00:00 / 00:00"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />

</LinearLayout>
