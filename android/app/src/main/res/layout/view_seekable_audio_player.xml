<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_container"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <ImageButton
        android:id="@+id/btnPlayerToggle"
        style="@style/Widget.IndicVoice.IconButton"
        android:contentDescription="@string/audio_play"
        android:src="@drawable/ic_play"
        app:tint="@color/player_control" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/sbPlayerProgress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:contentDescription="@string/audio_position"
            android:max="1000"
            android:progressBackgroundTint="@color/text_tertiary"
            android:progressTint="@color/player_control"
            android:thumbTint="@color/player_control" />

        <TextView
            android:id="@+id/tvPlayerTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingBottom="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
